{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  },
  "pnpm": {
    "overrides": {
      "micromatch>picomatch": "^2.3.2",
      "jest-util>picomatch": "^2.3.2",
      "vite>picomatch": "^4.0.5",
      "@expo/metro-config>picomatch": "^4.0.5",
      "@expo/cli>picomatch": "^4.0.5",
      "path-to-regexp": "^8.4.2",
      "fast-uri": "^3.1.5",
      "js-cookie": "^3.0.7",
      "lodash": "^4.18.0",
      "uuid": "^11.1.1",
      "yaml": "^2.8.3",
      "ws": "^8.21.0",
      "@esbuild-kit/core-utils>esbuild": "^0.25.0",
      "qs": "^6.15.2",
      "postcss": "^8.5.25",
      "minimatch@3>brace-expansion": "^2.1.4",
      "minimatch@10>brace-expansion": "^5.0.9",
      "minimatch@9>brace-expansion": "^2.1.4",
      "js-yaml@4": "^4.3.0",
      "js-yaml@3": "^3.15.0"
    }
  }
}
