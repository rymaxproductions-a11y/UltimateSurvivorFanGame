{
  "expo": {
    "name": "Ultimate Survivor Fan Game",
    "slug": "survivor-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "survivor-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1f17"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.replit.ultimatesurvivorfangame",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Ultimate Survivor Fan Game to access your photos so you can set a profile avatar.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://ultimatesurvivorgame.replit.app/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "3085d843-e9cb-427b-9904-85b23338b669"
      }
    }
  }
}
