{
  "expo": {
    "name": "Ultimate Survivor Fan Game",
    "slug": "survivor-guessing-game",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "survivor-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1f17"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.replit.ultimatesurvivorfangame",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Ultimate Survivor Fan Game uses the camera only when you choose Take Photo to create an in-game profile avatar. For example, you can take a selfie to use as your player picture.",
        "NSPhotoLibraryUsageDescription": "Ultimate Survivor Fan Game accesses your photo library only when you choose Choose Photo to set an in-game profile avatar.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.replit.ultimatesurvivorfangame",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://ultimate-survivor-fan-game.replit.app/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-notifications",
      "@clerk/expo"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "03004af4-62c8-40b3-8fcf-b26830e9a3c5"
      }
    }
  }
}
