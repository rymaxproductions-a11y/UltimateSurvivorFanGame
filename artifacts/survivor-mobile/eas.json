{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "pnpm": "10.26.1",
      "cache": {
        "disabled": true
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "ultimate-survivor-fan-game.replit.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
